rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Chat media, scoped per group. Any signed-in user can read (Firestore
    // rules are what actually gate who can see a group's messages in the
    // first place - this just needs to not be wide open to the internet).
    // A member can only upload into their own folder, and files can't be
    // overwritten once posted.
    match /groups/{groupId}/chat-media/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.size < 60 * 1024 * 1024
                    && (request.resource.contentType.matches('image/.*')
                        || request.resource.contentType.matches('video/.*'));
      allow update, delete: if false;
    }

    // Event attachments (posters, PDFs), scoped per group in the same way.
    match /groups/{groupId}/event-media/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.size < 15 * 1024 * 1024
                    && (request.resource.contentType.matches('image/.*')
                        || request.resource.contentType == 'application/pdf');
      allow update, delete: if false;
    }

    // Topic attachments, same treatment as event attachments.
    match /groups/{groupId}/topic-media/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.size < 15 * 1024 * 1024
                    && (request.resource.contentType.matches('image/.*')
                        || request.resource.contentType == 'application/pdf');
      allow update, delete: if false;
    }

    // A group's custom home-screen icon (optional - falls back to the
    // shared default if not set). Publicly readable without sign-in,
    // since "Add to Home Screen" fetches it as a plain image URL with no
    // auth attached. Uploading is gated to signed-in users only at this
    // layer; the /admin panel is the only place the UI to do this exists.
    match /groups/{groupId}/group-icon/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }
  }
}
