rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin status: a person is an admin if a doc with their uid exists here.
    // Only ever created manually by you in Firestore console - nobody can
    // grant themselves admin access through the app.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // A group's own record (name etc.) - readable by any signed-in user so
    // the app can show the group's display name before confirming
    // membership. Groups can be created by recognized admins through the
    // /admin panel, or manually in Firestore console.
    match /groups/{groupId} {
      allow read: if true;
      allow create, update: if request.auth != null
                    && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow delete: if false;

      // Membership in a group is defined simply by having a member doc
      // here - a person can have one in as many different groups as they
      // like, each checked independently.
      match /members/{memberId} {
        allow read: if request.auth != null
                    && (request.auth.uid == memberId
                        || exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)));
        allow create: if request.auth != null && request.auth.uid == memberId;
        allow update: if request.auth != null && request.auth.uid == memberId;
        allow delete: if false;
      }

      match /events/{eventId} {
        allow read: if request.auth != null
                    && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
        allow create, update: if request.auth != null
                    && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
        allow delete: if false;

        match /rsvps/{uid} {
          allow read: if request.auth != null
                      && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
          allow write: if request.auth != null && request.auth.uid == uid;
        }

        // A member's own "last read" marker for this event - same pattern
        // as Topics, so the unread dot works the same way for both.
        match /reads/{uid} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }

      match /messages/{messageId} {
        allow read: if request.auth != null
                    && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
        allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.senderId
                    && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
        allow update, delete: if false;
      }

      // Topics: a lighter-weight alternative to Events - just a title and
      // its own chat thread, open to any member to create.
      match /topics/{topicId} {
        allow read: if request.auth != null
                    && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
        allow create, update: if request.auth != null
                    && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
        allow delete: if false;

        match /messages/{messageId} {
          allow read: if request.auth != null
                      && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
          allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.senderId
                      && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
          allow update, delete: if false;
        }

        // A member's own "last read" marker for this topic - only they can
        // read or write it, so nobody else ever sees who's read what.
        match /reads/{uid} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }
    }
  }
}
