rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone signed in can read the member directory.
    // A member can only create/edit their own card (doc id == their uid).
    match /members/{memberId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == memberId;
    }

    // Any signed-in member can read and add events.
    // (Tighten "create/update" further if you want only admins managing events -
    // see the note in README.md.)
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;

      match /rsvps/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Chat + event-discussion messages share one collection.
    // Anyone signed in can read; a member can only create messages under
    // their own uid, and messages can't be edited or deleted once posted.
    match /messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.senderId;
      allow update, delete: if false;
    }
  }
}
